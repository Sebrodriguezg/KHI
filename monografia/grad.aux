\@writefile{lof}{\contentsline {figure}{\numberline {6.7}{\ignorespaces La zona de transición como \emph  {cascada de activación}. Sobre la curva $\gamma _{\mathrm  {KHI}}(\sigma )$ (sigmoide ajustada y datos), se marcan los $\sigma $ críticos de cada mecanismo: el borde inferior $\sigma \approx 1400$ (máximo de $f_{Vz}$; sin fase lineal por debajo), los cuatro estimadores interiores ($\sigma _0=2815$ centro de $\gamma _{\mathrm  {KHI}}$; M2$=3400$ inflexión de $\Omega _{zp}^{\mathop {\mathgroup \symoperators m\acute  {a}x}}$; M3$=6000$ inflexión de $t_{\mathrm  {peak}}$; M1$=6800$ aceleración máxima de $\gamma _{\mathrm  {KHI}}$) y el borde superior $\sigma \approx 7000$ (2.º pico de $\Omega _{zp}^{\mathop {\mathgroup \symoperators m\acute  {a}x}}$; ideal por encima). La banda naranja $\sigma \in [1400,7000]$ es la zona de transición; las regiones resistiva e ideal flanquean.}}{94}{figure.caption.52}\protected@file@percent }
\newlabel{fig:zona_transicion}{{6.7}{94}{La zona de transición como \emph {cascada de activación}. Sobre la curva $\gKHI (\sigma )$ (sigmoide ajustada y datos), se marcan los $\sigma $ críticos de cada mecanismo: el borde inferior $\sigma \approx 1400$ (máximo de $f_{Vz}$; sin fase lineal por debajo), los cuatro estimadores interiores ($\sigma _0=2815$ centro de $\gKHI $; M2$=3400$ inflexión de $\Omaxzp $; M3$=6000$ inflexión de $t_{\mathrm {peak}}$; M1$=6800$ aceleración máxima de $\gKHI $) y el borde superior $\sigma \approx 7000$ (2.º pico de $\Omaxzp $; ideal por encima). La banda naranja $\sigma \in [1400,7000]$ es la zona de transición; las regiones resistiva e ideal flanquean}{figure.caption.52}{}}
\newlabel{fig:zona_transicion@cref}{{[figure][7][6]6.7}{[1][93][]94}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.8}{\ignorespaces Construcción de la zona de transición: coeficiente $R^2_{\mathrm  {fija}}$ del ajuste lineal de $\ln \Omega _{zp}(t)$ frente a $\sigma $. Los umbrales clasifican cada simulación en régimen \emph  {resistivo} ($R^2<0.90$, rojo), \emph  {transición} ($0.90\le R^2<0.995$, naranja) o \emph  {ideal} ($R^2\ge 0.995$, verde), delimitando la banda $\sigma \in [1400,7000]$ donde se localiza $\sigma _{\mathrm  {crit}}$. La línea discontinua es el $R^2$ con ventana óptima, como referencia.}}{94}{figure.caption.53}\protected@file@percent }
\newlabel{fig:regimenes}{{6.8}{94}{Construcción de la zona de transición: coeficiente $R^2_{\mathrm {fija}}$ del ajuste lineal de $\ln \Ozp (t)$ frente a $\sigma $. Los umbrales clasifican cada simulación en régimen \emph {resistivo} ($R^2<0.90$, rojo), \emph {transición} ($0.90\le R^2<0.995$, naranja) o \emph {ideal} ($R^2\ge 0.995$, verde), delimitando la banda $\sigma \in [1400,7000]$ donde se localiza $\scrit $. La línea discontinua es el $R^2$ con ventana óptima, como referencia}{figure.caption.53}{}}
\newlabel{fig:regimenes@cref}{{[figure][8][6]6.8}{[1][93][]94}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.9}{\ignorespaces Estimadores de $\sigma _{\mathrm  {crit}}$ por inflexión. Derivada logarítmica de cada observable frente a $\sigma $: (arriba) $\gamma _{\mathrm  {KHI}}(\sigma )$ $\Rightarrow $ M1$\,=6800\pm 2625$; (centro) $\ln \Omega _{zp}^{\mathop {\mathgroup \symoperators m\acute  {a}x}}(\sigma )$ $\Rightarrow $ M2$\,=3400\pm 2175$ (con un segundo pico que marca el borde transición$\to $ideal $\sigma \approx 7000$); (abajo) $t_{\mathrm  {peak}}(\sigma )$ $\Rightarrow $ M3$\,=6000\pm 1147$. La línea vertical marca la inflexión y la banda sombreada la zona de transición.}}{96}{figure.caption.54}\protected@file@percent }
\newlabel{fig:derivadas_scrit}{{6.9}{96}{Estimadores de $\scrit $ por inflexión. Derivada logarítmica de cada observable frente a $\sigma $: (arriba) $\gKHI (\sigma )$ $\Rightarrow $ M1$\,=6800\pm 2625$; (centro) $\ln \Omaxzp (\sigma )$ $\Rightarrow $ M2$\,=3400\pm 2175$ (con un segundo pico que marca el borde transición$\to $ideal $\sigma \approx 7000$); (abajo) $t_{\mathrm {peak}}(\sigma )$ $\Rightarrow $ M3$\,=6000\pm 1147$. La línea vertical marca la inflexión y la banda sombreada la zona de transición}{figure.caption.54}{}}
\newlabel{fig:derivadas_scrit@cref}{{[figure][9][6]6.9}{[1][95][]96}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.3}{\ignorespaces Estimadores de $\sigma _{\text  {crit}}$ ordenados por $\sigma $ (la cascada): cada método marca el punto crítico de un mecanismo distinto. El error del sigmoide ($\pm 123$) es solo la precisión \emph  {formal} de ese método y \emph  {subestima} (residuos autocorrelacionados); la incertidumbre honesta es la dispersión inter-método ($\pm 1944$), y el resultado físico es la \emph  {zona} $\sigma \in [1400,7000]$ con centro $\sigma _{\text  {crit}}=\sigma _0\approx 2815$.}}{97}{figure.caption.55}\protected@file@percent }
\newlabel{tab:est_v6}{{6.3}{97}{Estimadores de $\sigma _{\text {crit}}$ ordenados por $\sigma $ (la cascada): cada método marca el punto crítico de un mecanismo distinto. El error del sigmoide ($\pm 123$) es solo la precisión \emph {formal} de ese método y \emph {subestima} (residuos autocorrelacionados); la incertidumbre honesta es la dispersión inter-método ($\pm 1944$), y el resultado físico es la \emph {zona} $\sigma \in [1400,7000]$ con centro $\sigma _{\text {crit}}=\sigma _0\approx 2815$}{figure.caption.55}{}}
\newlabel{tab:est_v6@cref}{{[table][3][6]6.3}{[1][96][]97}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.10}{\ignorespaces Los cuatro estimadores de $\sigma _{\text  {crit}}$ con sus incertidumbres, sobre la \emph  {zona de transición} (banda naranja $\sigma \in [1400,7000]$). La media ponderada ($\approx \sigma _0$, dominada casi por completo por el sigmoide) y la media aritmética se muestran como referencias; es el \emph  {ancho de la banda}, no el error formal del sigmoide, lo que refleja la incertidumbre real.}}{97}{figure.caption.55}\protected@file@percent }
\newlabel{fig:est_v6}{{6.10}{97}{Los cuatro estimadores de $\sigma _{\text {crit}}$ con sus incertidumbres, sobre la \emph {zona de transición} (banda naranja $\sigma \in [1400,7000]$). La media ponderada ($\approx \sigma _0$, dominada casi por completo por el sigmoide) y la media aritmética se muestran como referencias; es el \emph {ancho de la banda}, no el error formal del sigmoide, lo que refleja la incertidumbre real}{figure.caption.55}{}}
