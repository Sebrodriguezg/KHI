\@writefile{lof}{\contentsline {figure}{\numberline {6.21}{\ignorespaces Campaña B (plano $y$--$z$): enstrofía de perturbación frente al ángulo $\theta $, en dos observables. \emph  {Izquierda:} enstrofía integrada $\Omega ^{\mathrm  {int}}_{zp}$ (contenido total de vorticidad), máxima a $\theta $ bajo y decreciente con la tensión. \emph  {Derecha:} máximo puntual $\Omega ^{\mathop {\mathgroup \symoperators m\acute  {a}x}}_{zp}$, dominado por capas de reconexión finas y máximo en $\theta =90^\circ $. La discrepancia muestra que la ``paradoja'' de $\theta =90^\circ $ es un efecto del observable, no de la física de tensión. ($\sigma =6000$, CFL$=0.04$; $\sigma =10000$, CFL$=0.02$.)}}{115}{figure.caption.70}\protected@file@percent }
\newlabel{fig:campB_omegamax_theta}{{6.21}{115}{Campaña B (plano $y$--$z$): enstrofía de perturbación frente al ángulo $\theta $, en dos observables. \emph {Izquierda:} enstrofía integrada $\Omega ^{\mathrm {int}}_{zp}$ (contenido total de vorticidad), máxima a $\theta $ bajo y decreciente con la tensión. \emph {Derecha:} máximo puntual $\Omega ^{\max }_{zp}$, dominado por capas de reconexión finas y máximo en $\theta =90^\circ $. La discrepancia muestra que la ``paradoja'' de $\theta =90^\circ $ es un efecto del observable, no de la física de tensión. ($\sigma =6000$, CFL$=0.04$; $\sigma =10000$, CFL$=0.02$.)}{figure.caption.70}{}}
\newlabel{fig:campB_omegamax_theta@cref}{{[figure][21][6]6.21}{[1][114][]115}{}{}{}}
