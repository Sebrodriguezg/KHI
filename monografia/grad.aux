\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Espacio de parámetros de la campaña magnética sobre el montaje del doble-KHI (plano de simulación con las dos interfaces de cizalla en $x=\pm 0.5$, flujo $\mathbf  V$ a lo largo de $\hat  y$ y campo guía nominal $\hat  z$). \emph  {A (intensidad):} se conserva la orientación Mizuno y se escala $|\mathbf  B|$ ($B_0=1,1.5,2$). \emph  {B (orientación $y$--$z$):} $\mathbf  B$ rota de $\hat  z$ hacia $\hat  y$; como $\hat  y\parallel \mathbf  k$, la componente $B_y$ ejerce tensión ($\propto B_y^2$). \emph  {C (orientación $x$--$z$):} $\mathbf  B$ rota de $\hat  z$ hacia $\hat  x$ con $B_y=0$; al ser $B_x\perp \mathbf  k$ se tiene $\mathbf  k\cdot \mathbf  B=0$ y no hay tensión.}}{79}{figure.caption.37}\protected@file@percent }
\newlabel{fig:campanas_BC_3d}{{5.2}{79}{Espacio de parámetros de la campaña magnética sobre el montaje del doble-KHI (plano de simulación con las dos interfaces de cizalla en $x=\pm 0.5$, flujo $\mathbf V$ a lo largo de $\hat y$ y campo guía nominal $\hat z$). \emph {A (intensidad):} se conserva la orientación Mizuno y se escala $|\mathbf B|$ ($B_0=1,1.5,2$). \emph {B (orientación $y$--$z$):} $\mathbf B$ rota de $\hat z$ hacia $\hat y$; como $\hat y\parallel \mathbf k$, la componente $B_y$ ejerce tensión ($\propto B_y^2$). \emph {C (orientación $x$--$z$):} $\mathbf B$ rota de $\hat z$ hacia $\hat x$ con $B_y=0$; al ser $B_x\perp \mathbf k$ se tiene $\mathbf k\cdot \mathbf B=0$ y no hay tensión}{figure.caption.37}{}}
\newlabel{fig:campanas_BC_3d@cref}{{[figure][2][5]5.2}{[1][78][]79}{}{}{}}
