\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.1}Partición de Operadores: Integración Explícita e Implícita}{68}{subsection.4.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Partición de operadores del esquema IMEX-RK. El sistema se separa en una parte \emph  {no rígida} ---los flujos hiperbólicos $-\partial _i\mathbf  F^i$, integrados de forma \emph  {explícita} con reconstrucción MP5 y solucionador HLL--- y una parte \emph  {rígida} ---el término fuente resistivo $\mathbf  S_{\rm  rig}=-\sigma \mathbf  E$, tratado de forma \emph  {implícita} mediante inversión algebraica local---. Así el paso de tiempo queda gobernado por la advección ($\Delta t\propto \Delta x$) y no por la rigidez resistiva ($\Delta t\propto \Delta x^2$), que paralizaría un integrador explícito.}}{69}{figure.caption.33}\protected@file@percent }
\newlabel{fig:imex_splitting}{{4.4}{69}{Partición de operadores del esquema IMEX-RK. El sistema se separa en una parte \emph {no rígida} ---los flujos hiperbólicos $-\partial _i\mathbf F^i$, integrados de forma \emph {explícita} con reconstrucción MP5 y solucionador HLL--- y una parte \emph {rígida} ---el término fuente resistivo $\mathbf S_{\rm rig}=-\sigma \mathbf E$, tratado de forma \emph {implícita} mediante inversión algebraica local---. Así el paso de tiempo queda gobernado por la advección ($\Delta t\propto \Delta x$) y no por la rigidez resistiva ($\Delta t\propto \Delta x^2$), que paralizaría un integrador explícito}{figure.caption.33}{}}
\newlabel{fig:imex_splitting@cref}{{[figure][4][4]4.4}{[1][68][]69}{}{}{}}
